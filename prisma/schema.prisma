// ==============================================================================
// PRISMA SCHEMA — ENTERPRISE SPREADSHEET PLATFORM
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum WorkbookPermType {
  VIEW
  EDIT
  EXPORT
  SHARE
  FULL
}

enum JobType {
  IMPORT_XLSX
  IMPORT_CSV
  EXPORT_XLSX
  EXPORT_CSV
  GENERATE_PREVIEW
  BACKUP_WORKBOOK
  RESTORE_WORKBOOK
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  FAILED_VALIDATION
  CANCELLED
}

// ------------------------------------------------------------------------------
// AUTHENTICATION & RBAC
// ------------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(50)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.Text
  fullName     String     @map("full_name") @db.VarChar(100)
  isSystemRoot Boolean    @default(false) @map("is_system_root")
  status       UserStatus @default(PENDING)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  roles           UserRole[]
  sessions        Session[]
  ownedWorkbooks  Workbook[]           @relation("WorkbookOwner")
  wbPermissions   WorkbookPermission[]
  auditLogs       AuditLog[]
  jobs            JobRecord[]
  createdVersions WorkbookVersion[]
  mutationBatches MutationBatch[]

  @@index([email])
  @@index([username])
  @@index([status])
  @@index([isSystemRoot])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  category    String   @db.VarChar(50)

  roles       RolePermission[]

  @@index([code])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ------------------------------------------------------------------------------
// WORKBOOK PERSISTENCE & VERSIONING
// ------------------------------------------------------------------------------

model Workbook {
  id               String    @id @default(uuid()) @db.Uuid
  ownerId          String    @map("owner_id") @db.Uuid
  name             String    @db.VarChar(255)
  originalFilename String    @map("original_filename") @db.VarChar(255)
  currentVersion   Int       @default(1) @map("current_version")
  storageKey       String    @map("storage_key") @db.VarChar(512)
  mimeType         String    @default("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet") @map("mime_type") @db.VarChar(128)
  sizeBytes        BigInt    @map("size_bytes")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  lastOpenedAt     DateTime? @map("last_opened_at") @db.Timestamptz

  owner            User                 @relation("WorkbookOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  versions         WorkbookVersion[]
  permissions      WorkbookPermission[]
  jobs             JobRecord[]
  state            WorkbookState?
  snapshots        WorkbookSnapshot[]
  mutationBatches  MutationBatch[]
  calcResults      CalculationResult[]

  @@index([ownerId])
  @@index([updatedAt])
  @@index([isDeleted])
  @@map("workbooks")
}

model WorkbookVersion {
  id             String   @id @default(uuid()) @db.Uuid
  workbookId     String   @map("workbook_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  storageKey     String   @map("storage_key") @db.VarChar(512)
  sizeBytes      BigInt   @map("size_bytes")
  checksumSha256 String   @map("checksum_sha256") @db.Char(64)
  changeSummary  String?  @map("change_summary") @db.VarChar(255)
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workbook       Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  creator        User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([workbookId, versionNumber])
  @@index([workbookId, createdAt])
  @@map("workbook_versions")
}

model WorkbookPermission {
  workbookId String           @map("workbook_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  permission WorkbookPermType
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  workbook   Workbook         @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workbookId, userId])
  @@index([userId])
  @@map("workbook_permissions")
}

// ------------------------------------------------------------------------------
// JOB AUDIT & BACKGROUND RECORDS
// ------------------------------------------------------------------------------

model JobRecord {
  id           String    @id @default(uuid()) @db.Uuid
  bullJobId    String?   @map("bull_job_id") @db.VarChar(128)
  userId       String    @map("user_id") @db.Uuid
  workbookId   String?   @map("workbook_id") @db.Uuid
  type         JobType
  status       JobStatus @default(QUEUED)
  progress     Int       @default(0)
  errorMessage String?   @map("error_message") @db.Text
  metadata     Json?     @db.JsonB
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz

  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  workbook     Workbook? @relation(fields: [workbookId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([workbookId])
  @@index([createdAt])
  @@map("job_records")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// ASYNCHRONOUS BACKEND CALCULATION PERSISTENCE & MUTATION WAL
// ------------------------------------------------------------------------------

model WorkbookState {
  workbookId          String   @id @map("workbook_id") @db.Uuid
  latestPersistedRev  BigInt   @default(0) @map("latest_persisted_rev")
  latestCalculatedRev BigInt   @default(0) @map("latest_calculated_rev")
  lastSnapshotRev     BigInt   @default(0) @map("last_snapshot_rev")
  fencingToken        BigInt   @default(0) @map("fencing_token")
  activeWorkerId      String?  @map("active_worker_id") @db.VarChar(128)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  @@map("workbook_states")
}

model WorkbookSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  workbookId       String   @map("workbook_id") @db.Uuid
  snapshotRev      BigInt   @map("snapshot_rev")
  binaryData       Bytes    @map("binary_data")
  byteSize         Int      @map("byte_size")
  compressionCodec String   @default("zstd") @map("compression_codec") @db.VarChar(32)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  @@unique([workbookId, snapshotRev])
  @@index([workbookId, createdAt(sort: Desc)])
  @@map("workbook_snapshots")
}

model MutationBatch {
  id             String   @id @default(uuid()) @db.Uuid
  workbookId     String   @map("workbook_id") @db.Uuid
  revisionId     BigInt   @map("revision_id")
  userId         String   @map("user_id") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  deltas         Json     @map("deltas") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workbookId, revisionId])
  @@index([workbookId, revisionId])
  @@map("mutation_batches")
}

model CalculationResult {
  id              String   @id @default(uuid()) @db.Uuid
  workbookId      String   @map("workbook_id") @db.Uuid
  calculatedRev   BigInt   @map("calculated_rev")
  cellPatches     Json     @map("cell_patches") @db.JsonB
  executionMs     Int      @map("execution_ms")
  plannerStrategy String   @map("planner_strategy") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  @@unique([workbookId, calculatedRev])
  @@index([workbookId, calculatedRev])
  @@map("calculation_results")
}
